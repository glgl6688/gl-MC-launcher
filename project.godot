; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="gl启动器"
config/description="第三方本地 Minecraft 启动器：版本发现、实例配置、Java 选择、第三方/正版登录、组件管理与日志。"
config/version="1.0.0"
config/copyright="Copyright (c) 2026 glgl6688"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ConfigManager="*res://scripts/core/config_manager.gd"
LogManager="*res://scripts/core/log_manager.gd"
ErrorReporter="*res://scripts/core/error_reporter.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=1000
window/size/min_height=700

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0705882, 0.0784314, 0.0980392, 1)
